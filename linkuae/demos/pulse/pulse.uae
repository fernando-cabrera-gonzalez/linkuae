; Pulse: everything the demo needs, with no Kickstart file and no hard disk.
; The disk path is given on the command line by panel.py.
config_description=Pulse demo
use_gui=no
kickstart_rom_file=:AROS
nr_floppies=1
floppy0type=0
floppy_speed=800
cpu_type=68000
cpu_speed=real
chipset=ecs_agnus
chipmem_size=1
bogomem_size=0
fastmem_size=0
sound_output=none
linkuae=true
